// amifl-spec.md 15.3: `extern "."` resolves to this .aml file's own
// directory, and picks up every *.go file directly inside it (non-
// recursive) — no separate build step, no go.mod of your own to manage.
extern "." as mh {
    bind Gcd(a: Int, b: Int) -> Int as GCD
}

fn main() -> Int {
    let g1 = Gcd(48, 18)   // 6
    let g2 = Gcd(17, 5)    // 1
    print(g1)
    print(g2)
    g1 + g2
}
