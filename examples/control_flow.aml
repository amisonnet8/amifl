// ex11: `return`/`return expr` — early exit from the enclosing fn.
fn earlyIfNegative(x: Int) -> Int {
    if x < 0 {
        return 0
    }
    x * 2
}

fn firstOverThreshold(xs: List[Int], threshold: Int) -> Int {
    for x in xs {
        if x > threshold {
            return x
        }
    }
    -1
}

// `return` may be an if-branch's tail alongside a sibling of a real,
// unrelated type — it resolves to the compiler-internal Never type, which
// matches any expected type (amifl-spec.md section 2.2).
fn describeSign(x: Int) -> String {
    if x < 0 { return "negative" } else { "non-negative" }
}

fn main() -> Int {
    let score: Int = 82
    let grade: String = if score >= 90 {
        "A"
    } elif score >= 80 {
        "B"
    } elif score >= 70 {
        "C"
    } else {
        "F"
    }
    print(grade)

    let category: String = switch {
        case score >= 90: "excellent"
        case score >= 70: "good"
        default: "needs work"
    }
    print(category)

    if score >= 80 {
        print("passed")
    } else {
        print("failed")
    }

    let mut: Int = 100
    if mut > 0 {
        mut = mut - 1
    }

    let mut2: Int = 0
    while mut2 < 5 {
        mut2 = mut2 + 1
    }

    let sumTo: Int = 10
    let mut3: Int = 0
    let total: Int = 0
    while mut3 < sumTo {
        mut3 = mut3 + 1
        if mut3 == 4 {
            continue
        }
        if mut3 > 8 {
            break
        }
        total = total + mut3
    }

    let shadowTest: Int = 1
    if true {
        let shadowTest: Int = 99
        print(if shadowTest == 99 { "shadowed" } else { "not shadowed" })
    }

    let unitIf: Int = if false { 1 } else { 2 }

    let earlyNeg: Int = earlyIfNegative(-5)
    let earlyPos: Int = earlyIfNegative(5)
    let firstOver: Int = firstOverThreshold([1, 2, 3, 10, 4], 5)
    print(describeSign(-1))
    print(describeSign(7))

    total + shadowTest + unitIf + mut + mut2 + earlyNeg + earlyPos + firstOver
}
