fn sumList(xs: List[Int]) -> Int {
    let total = 0
    for x in xs {
        total = total + x
    }
    total
}

fn sumArray(xs: Array[Int;5]) -> Int {
    let total = 0
    for x in xs {
        total = total + x
    }
    total
}

fn main() -> Int {
    let xs: List[Int] = [1, 2, 3, 4, 5]
    let s1 = sumList(xs)

    let arr: Array[Int;5] = [10, 20, 30, 40, 50]
    let s2 = sumArray(arr)

    let grid: Array[Array[Int;3];3] = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    grid[1][1] = 99
    let center = grid[1][1]

    let a0 = xs[0]
    let a4 = xs[4]

    let part = xs[1:3]
    let p0 = part[0]
    let p1 = part[1]

    let tail = xs[3:]
    let t0 = tail[0]
    let t1 = tail[1]

    let head = xs[:2]
    let h0 = head[0]
    let h1 = head[1]

    let whole = xs[:]
    let w0 = whole[0]

    let acc = 0
    for row in grid {
        for cell in row {
            acc = acc + cell
        }
    }

    s1 + s2 + center + a0 + a4 + p0 + p1 + t0 + t1 + h0 + h1 + w0 + acc
}
