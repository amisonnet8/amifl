fn add(a: Int, b: Int) -> Int {
    a + b
}

fn factorial(n: Int) -> Int {
    if n <= 1 {
        1
    } else {
        n * factorial(n - 1)
    }
}

fn isEven(n: Int) -> Bool {
    if n == 0 {
        true
    } else {
        isOdd(n - 1)
    }
}

fn isOdd(n: Int) -> Bool {
    if n == 0 {
        false
    } else {
        isEven(n - 1)
    }
}

fn logMsg(msg: String) -> Unit {
    print(msg)
}

fn main() -> Int {
    let sum = add(3, 4)
    print(if isEven(10) { "even" } else { "odd" })
    let fact4 = factorial(4)
    logMsg("logged")

    let square = fn(x: Int) -> Int { x * x }
    let sq = square(5)

    let base = 50
    let addBase = fn(x: Int) -> Int { x + base }
    let ab = addBase(3)

    sum + fact4 + sq + ab
}
