fn double(x: Int) -> Int {
    x * 2
}

fn addN(x: Int, n: Int) -> Int {
    x + n
}

fn sum(xs: List[Int]) -> Int {
    let total = 0
    for x in xs {
        total = total + x
    }
    total
}

fn main() -> Int {
    let a = 5 |> double
    let b = 5 |> addN(_, 3)
    let c = 5 |> addN(3, _)

    let nums: List[Int] = [1, 2, 3, 4]
    let doubled = for x in nums yield x |> double
    let s1 = sum(doubled)

    let bumped = for x in nums yield addN(x, 10)
    let s2 = sum(bumped)

    let tapped = 7 |> tap(_, "seven")
    let peeked = peek(9)

    // ex4: an inline closure literal directly as a pipe's right-hand
    // side (amifl-spec.md section 9) — lhs becomes the closure's sole
    // argument, exactly like `|> double` above but without needing a
    // name in scope for a one-off transformation.
    let d = 5 |> fn(x: Int) -> Int { x * x }

    // Chains freely with an ordinary named stage on either side.
    let e = 5 |> double |> fn(x: Int) -> Int { x + 1 }

    // Also usable inside for...yield's own piped yield expression.
    let squared = for x in nums yield x |> fn(v: Int) -> Int { v * v }
    let s3 = sum(squared)

    // Unit-returning inline closure used purely for effect (statement
    // position, not the block's final expression).
    3 |> fn(v: Int) -> Unit { print("inline pipe closure saw a value") }

    // ex8: a `|>` chain may continue onto the next line — recognized purely
    // because the next line starts with `|>` (amifl-spec.md section 5).
    let f = 5
        |> double
        |> fn(x: Int) -> Int { x + 1 }

    a + b + c + s1 + s2 + tapped + peeked + d + e + s3 + f
}
