const Base: Int = 40
const Bonus: Int = 2
const Combined: Int = Base + Bonus

// ex9: `&&`/`||` short-circuit — these print as a side effect purely so
// main can prove (via the print order) whether they actually ran.
fn loudTrue(tag: String) -> Bool {
    print(tag)
    true
}

fn loudFalse(tag: String) -> Bool {
    print(tag)
    false
}

fn main() -> Int {
    let greeting: String = "Hello" + ", " + "AmiFL!"
    print(greeting)

    let a: Int = 10
    let b: Int = 3

    let sum: Int = a + b
    let diff: Int = a - b
    let bits: Int = 6 & 3
    let orBits: Int = 5 | 2
    let xorBits: Int = 5 ^ 3
    let clearBits: Int = 6 &^ 2
    let shiftedLeft: Int = 1 << 3
    let shiftedRight: Int = 16 >> 2

    let negFive: Int = -5
    let doubleNeg: Int = -negFive

    let minInt8: Int8 = -128
    let notBits: Int8 = ~5

    let isGreater: Bool = a > b
    let isEqualSum: Bool = sum == 13
    let logic: Bool = isGreater && isEqualSum || false
    let notLogic: Bool = !logic
    let strCmp: Bool = "abc" < "abd"
    let boolEq: Bool = true == true

    let precedenceCheck: Int = 2 + 3 * 4
    let grouped: Int = (2 + 3) * 4

    // ex9: short-circuit — loudFalse("skipped &&") never runs (its print
    // never happens) because the left side of && already makes the whole
    // expression false; loudTrue("skipped ||") never runs for the same
    // reason on the || side.
    let shortAnd: Bool = false && loudFalse("skipped &&")
    let shortOr: Bool = true || loudTrue("skipped ||")
    let ranAnd: Bool = true && loudTrue("&& evaluated its right side")
    let ranOr: Bool = false || loudFalse("|| evaluated its right side")
    let shortCircuitCheck: Int = (if shortAnd { 0 } else { 1 }) + (if shortOr { 1 } else { 0 }) + (if ranAnd { 1 } else { 0 }) + (if ranOr { 0 } else { 1 })

    let total: Int = sum + diff + bits + orBits + xorBits + clearBits + shiftedLeft + shiftedRight + doubleNeg
    let verified: Int = total + (Combined - 42) + (precedenceCheck - 14) + (grouped - 20) + shortCircuitCheck

    verified
}
